# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/synccode?retryWrites=true&w=majority

# Google Gemini API key for AI features (required)
API_KEY=your_google_api_key_here

# Judge0 code execution (optional - uses public ce.judge0.com by default)
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here

# Port (set automatically by Render, defaults to 5000 locally)
# PORT=5000

# Client backend URL (optional - auto-detected in production)
# REACT_APP_BACKEND_URL=http://localhost:5000
